# Cloudflare Pages / Netlify header rules.
#
# The TeX Live store and the engine are content-addressed by their build: a
# changed file gets a new build, never a new body at the same URL. Caching them
# forever is what makes a repeat visit cost nothing — for the visitor and for
# the bandwidth bill.

/swiftlatex/*
  Cache-Control: public, max-age=31536000, immutable

/pdfjs/*
  Cache-Control: public, max-age=31536000, immutable

# The store is served uncompressed and compressed by the host. Do NOT
# pre-compress these and set Content-Encoding here: a host that also compresses
# on the fly (GitHub Pages does) leaves the browser stripping one layer and the
# engine reading gzip bytes where it expected a font.
/texlive/files/*
  Cache-Control: public, max-age=31536000, immutable

# The manifest is the one file that changes when the store is rebuilt.
/texlive/manifest.json
  Cache-Control: public, max-age=3600, must-revalidate
